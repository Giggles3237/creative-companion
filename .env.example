# The administrator account allowed to open /admin.
ADMIN_EMAIL=your-admin-email@example.com

# 32 random bytes encoded as 64 lowercase hexadecimal characters.
# Example command: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Optional. The app runs with prepared examples when these are unset.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-1

# Eleven Music creates complete songs. The voice model is reserved for
# narration and future spoken-word journeys.
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music_v2
ELEVENLABS_VOICE_MODEL=eleven_multilingual_v2
